    "format_string": "",
    "description": "LANL standard 6/7-token log envelope",
    "children": [
      {
        "rule_id": "RULE-BENIGN-FAN",
        "pattern": "^Fan speeds \\( .* \\)$",
        "rule_type": "BENIGN_TELEMETRY",
        "resolution": null,

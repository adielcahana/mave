        "validation_status": "VALIDATED"
      },
      {
        "rule_id": "RULE-BENIGN-AMBIENT",
        "pattern": "^ambient\\s*=\\s*\\d+$",
        "rule_type": "BENIGN_TELEMETRY",
        "resolution": null,
        "human_validated": true,
        "validation_status": "VALIDATED"
      },
      {
        "rule_id": "RULE-BENIGN-LINK-OK",
